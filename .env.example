# HackerXploit Environment Configuration Template
#
# Every secret below MUST be replaced with a unique, randomly generated value
# before deploying. The app refuses to start in production (FLASK_ENV=production)
# if SECRET_KEY, POSTGRES_PASSWORD (via DATABASE_URL), or CTFD_OAUTH_CLIENT_SECRET
# are left unset or match the placeholder values that used to ship here.
# Generate strong values with e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"

# General & Subdomains
# hackerxploit.org (bare root) is reserved for other, unrelated projects as
# of 2026-08-03 - this deployment only claims club.hackerxploit.org and
# arena.hackerxploit.org. DOMAIN is the registered base domain (used for the
# Certbot wildcard cert, which still covers both subdomains with one cert).
DOMAIN=hackerxploit.org
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
FLASK_ENV=production
SESSION_COOKIE_DOMAIN=.club.hackerxploit.org
SESSION_COOKIE_SECURE=true

# Database
POSTGRES_DB=hackerxploit
POSTGRES_USER=hx_user
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
DATABASE_URL=postgresql://hx_user:REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD@db:5432/hackerxploit

# Redis (requirepass is enforced in docker-compose.yml)
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD@redis:6379/0

# CTFd SSO Integration
# CTFD_OAUTH_PUBLIC_BASE_URL/CTFD_OAUTH_INTERNAL_WEB_URL are what
# scripts/init_ctfd.py actually reads (previous var names below this
# comment - CTFD_OAUTH_AUTH_URL/TOKEN_URL/API_URL - were never consumed by
# any script; removed to stop documenting dead config).
CTFD_OAUTH_CLIENT_ID=ctfd-client-id-hx99
CTFD_OAUTH_CLIENT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
CTFD_OAUTH_PUBLIC_BASE_URL=https://club.hackerxploit.org
CTFD_OAUTH_INTERNAL_WEB_URL=http://web:5000

# Sentry Error Tracking
SENTRY_DSN=
VITE_SENTRY_DSN=

# Cloudflare Turnstile CAPTCHA (Optional in Dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ClamAV Virus Scanner
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Upload directory
UPLOAD_FOLDER=/var/uploads

# DigitalOcean Container Registry
REGISTRY_URL=registry.digitalocean.com/hackerxploit
