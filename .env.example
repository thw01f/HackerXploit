# HackerXploit Environment Configuration Template

# General & Subdomains
DOMAIN=hackerxploit.org
SECRET_KEY=super-secret-production-key-change-me-in-prod
FLASK_ENV=production
SESSION_COOKIE_DOMAIN=.hackerxploit.org

# Database
POSTGRES_DB=hackerxploit
POSTGRES_USER=hx_user
POSTGRES_PASSWORD=hx_secure_password_123!
DATABASE_URL=postgresql://hx_user:hx_secure_password_123!@db:5432/hackerxploit

# Redis
REDIS_URL=redis://redis:6379/0

# CTFd SSO Integration
CTFD_OAUTH_CLIENT_ID=ctfd-client-id-hx99
CTFD_OAUTH_CLIENT_SECRET=ctfd-client-secret-sec88
CTFD_OAUTH_AUTH_URL=http://hackerxploit.org/oauth/authorize
CTFD_OAUTH_TOKEN_URL=http://web:5000/oauth/token
CTFD_OAUTH_API_URL=http://web:5000/oauth/userinfo

# Sentry Error Tracking
SENTRY_DSN=
VITE_SENTRY_DSN=

# Cloudflare Turnstile CAPTCHA (Optional in Dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ClamAV Virus Scanner
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Upload directory
UPLOAD_FOLDER=/var/uploads

# DigitalOcean Container Registry
REGISTRY_URL=registry.digitalocean.com/hackerxploit
